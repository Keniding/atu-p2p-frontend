{
  "name": "buslima-p2p",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "test": "bun test",
    "test:hooks": "jest --config jest.config.ts",
    "test:e2e": "detox test",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "eas:build:dev": "eas build --profile development",
    "eas:build:prod": "eas build --profile production",
    "eas:update": "eas update --branch production",
    "eas:submit": "eas submit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~55.0.0",
    "expo-constants": "~17.0.0",
    "expo-location": "~18.0.0",
    "expo-nearby-connections": "^1.1.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "^55.0.6",
    "expo-task-manager": "~12.0.0",
    "nativewind": "^4.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "^1.18.0",
    "react-native-nitro-modules": "^0.20.0",
    "react-native-permissions": "^5.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "detox": "^20.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "jest-expo": "~55.0.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.5.0"
  },
  "private": true
}
